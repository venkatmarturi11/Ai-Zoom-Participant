# ========================================
# Telegram Zoom Assistant — Environment
# ========================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram user IDs authorized to use the bot
AUTHORIZED_TELEGRAM_IDS=

# --- Zoom OAuth ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/zoom/callback

# --- Zoom Meeting SDK ---
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# --- Database ---
DATABASE_URL=postgresql://zoom_assistant:dev_password@localhost:5432/zoom_assistant

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
# 32-byte hex string for AES-256-GCM token encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Server ---
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# --- Bot Defaults ---
DEFAULT_DISPLAY_NAME=Meeting Assistant
DEFAULT_TIMEZONE=Asia/Kolkata
